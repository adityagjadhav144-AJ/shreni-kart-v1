{
  "id": "/",
  "name": "Shreni Kart",
  "short_name": "Shreni Kart",
  "description": "AI-powered marketplace and smart cataloging assistant for Indian artisans.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#ba3c1e",
  "background_color": "#faf6ee",
  "lang": "en",
  "dir": "ltr",
  "categories": ["shopping", "business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Shreni AI Voice",
      "short_name": "Voice AI",
      "description": "Speak with Shreni AI voice assistant",
      "url": "/chat",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Artisan Catalog",
      "short_name": "Catalog",
      "description": "View and manage handcrafted product catalog",
      "url": "/inventory",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add Handcrafted Item",
      "short_name": "Add Item",
      "description": "Create a new handcrafted product listing with voice",
      "url": "/products/new",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
